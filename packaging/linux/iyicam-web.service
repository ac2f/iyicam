# iyiCAM web service (systemd). packaging/linux/install.sh fills in this template
# and installs it as /etc/systemd/system/iyicam-web.service.
[Unit]
Description=iyiCAM web service (the CAM engine behind a page for a phone or any browser)
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@APP@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Everything iyiCAM keeps (the key in server.key, user posts, tools, plugins) lives here. The system user has no
# real home directory, so libraries that look at HOME get the same place.
Environment=IYICAM_HOME=/var/lib/iyicam
Environment=HOME=/var/lib/iyicam
# The folders of this computer in which the page may open and save files (separated by ":"); nothing else of
# the disk is reachable. The default is /var/lib/iyicam/files, set at the installation (IYICAM_ROOTS=...).
Environment=IYICAM_ROOTS=@ROOTS@

# Runs with the venv python. By default it listens on 127.0.0.1 only and a reverse proxy adds HTTPS;
# @PROXY@ is "--trust-proxy" exactly in that case (see docs/web.md before listening on another address).
# @FILES@ is "--no-files" when the page is not to open or save files of this computer at all.
# @HUB@ is "--hub" for a hub: no engine and no files here, agents (iyicam agent, on the computers of the people)
# connect to it and a browser signs in with the client key of an agent (docs/web.md).
# The key is made at the first start (/var/lib/iyicam/server.key) and stays valid until it is replaced
# with:  iyicam serve --new-key  (a running server notices it at once). For a hub it is the key that lets agents in.
ExecStart=@APP@/venv/bin/python -m iyicam serve --host @HOST@ --port @PORT@ @PROXY@ @FILES@ @HUB@ --quiet

Restart=on-failure
RestartSec=3
StateDirectory=iyicam
StateDirectoryMode=0700
# The files the page writes are readable by the group of the service user (the state folder itself is 0700).
UMask=0027
# The engine can take a lot of memory for a big drawing or a big nesting; raise it with
#   systemctl edit iyicam-web
MemoryMax=2G

# Hardening: the service needs the network, its own state directory and the folders it was given for files,
# nothing else (the system is read-only to it; a "-" in front of a path lets a missing folder pass).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@RW_PATHS@
# (a folder under /home needs ProtectHome=no, see docs/web.md)
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
